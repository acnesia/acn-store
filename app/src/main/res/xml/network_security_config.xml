<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only, system CAs only (no user-installed certificates) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Reviews API on the ACN VPS has no TLS yet: cleartext allowed for this host only -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">141.11.120.62</domain>
    </domain-config>
</network-security-config>
